# Configurazione Flask per QuestMasterAI
# Copia questo file in .env e modifica i valori secondo le tue necessità

# Chiave segreta Flask (IMPORTANTE: cambia in produzione!)
FLASK_SECRET_KEY=questmaster-ai-secret-key-change-in-production

# Modalità di sviluppo
FLASK_ENV=development
FLASK_DEBUG=True

# Google API Key (opzionale, può essere inserita nell'interfaccia)
# GOOGLE_API_KEY=tua_api_key_qui

# Configurazione del server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Percorsi dei file (di solito non è necessario modificare)
PDDL_FILES_DIR=file_generati
FAST_DOWNWARD_DIR=fast-downward-24.06.1
