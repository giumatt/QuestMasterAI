# File di configurazione per QuestMasterAI Flask App
# Copia questo file come .env e inserisci le tue chiavi

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=questmaster-ai-secret-key-change-in-production

# Google API Configuration (inserisci la tua chiave)
GOOGLE_API_KEY=your_google_api_key_here

# App Configuration
APP_HOST=0.0.0.0
APP_PORT=5000

# File paths (relativi alla root del progetto)

RAG_FILE=./file_esempio/documento_aiuto_RAG.pdf

VAL_PATH=your-validate-path-here


FAST_DOWNWARD_PATH=your-fast-downward-path-here
PDDL_DOMAIN_PATH=your-domain-path-here
PDDL_PROBLEM_PATH=your-problem-path-here
STORY_OUTPUT_PATH=your-story-output-path-here